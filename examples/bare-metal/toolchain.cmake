set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{ARM_GNU_ROOT})
  message(FATAL_ERROR "Set ARM_GNU_ROOT to an Arm GNU bare-metal toolchain installation.")
endif()
file(TO_CMAKE_PATH "$ENV{ARM_GNU_ROOT}" ARM_GNU_ROOT)
set(tool_suffix "")
if(CMAKE_HOST_WIN32)
  set(tool_suffix ".exe")
endif()
set(CMAKE_C_COMPILER "${ARM_GNU_ROOT}/bin/arm-none-eabi-gcc${tool_suffix}")
set(CMAKE_CXX_COMPILER "${ARM_GNU_ROOT}/bin/arm-none-eabi-g++${tool_suffix}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_SYSROOT "${ARM_GNU_ROOT}/arm-none-eabi")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -ffunction-sections -fdata-sections -Wno-error=shift-count-overflow -Wno-error=format")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-exceptions -fno-rtti")
get_filename_component(example_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
string(APPEND CMAKE_C_FLAGS_INIT " -include \"${example_dir}/platform.h\"")
string(APPEND CMAKE_CXX_FLAGS_INIT " -include \"${example_dir}/platform.h\"")
# Bindgen uses Clang, not the GCC driver.
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS_INIT}" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS_INIT}" CACHE STRING "" FORCE)
